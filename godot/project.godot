; Regicide's native practice board. Chess rules remain in the local game host.
config_version=5

[application]
config/name="Regicide"
config/icon="res://icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Regicide 자체 엔진과 두는 로컬 체스 대국"

[audio]
general/text_to_speech=true

[display]
window/size/viewport_width=1760
window/size/viewport_height=960
window/size/window_width_override=1760
window/size/window_height_override=960
window/size/min_width=900
window/size/min_height=680
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.046, 0.069, 0.105, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true

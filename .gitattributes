# Machine-generated experiment evidence is preserved but collapsed in code review.
docs/matches/** linguist-generated=true
docs/profiles/** linguist-generated=true
# Preserve gprof's original fixed-width headers, including their trailing spaces.
docs/profiles/** whitespace=-blank-at-eol
# PGN uses blank lines between games and after the final game.
*.pgn whitespace=-blank-at-eof
# Keep archived PVS evidence byte-identical so checkout line endings cannot
# invalidate the independent audit's JSON/PGN SHA256 values.
docs/matches/2026-10-18-pvs/** -text
# Windows CRLF and compiler output are part of the original evidence bytes.
docs/matches/2026-10-18-see/** -text -whitespace
docs/matches/2026-10-18-see-replication/** -text -whitespace
# The preregistered opening SHA256 must survive Windows and Linux checkouts.
tests/data/see_replication_openings_2026-10-18.json -text
tests/data/see_cost_openings_2026-10-18.json -text
tests/data/see_cost_freeze_2026-10-18.json -text
docs/matches/2026-10-18-see-cost/** -text -whitespace

# Keep the first training model, datasets and validation checksums byte-identical.
docs/checks/2026-10-19-neural-training/** -text -whitespace
# Preserve the exact measured source bytes/new-file line endings on Windows.
src/neural.cpp -text whitespace=cr-at-eol
tests/neural_model_tests.cpp text eol=lf
tests/neural_training_integration.py text eol=lf
requirements-training.txt text eol=lf

# Preserve the QAT freeze, model, datasets and measured source hashes on checkout.
docs/checks/2026-10-19-neural-qat/** -text -whitespace
docs/NEURAL_QAT.md text eol=lf
scripts/neural_qat.py -text
scripts/calibrate_neural_qat.py -text whitespace=cr-at-eol
scripts/neural_qat_experiment.py -text whitespace=cr-at-eol
scripts/benchmark_qat_models.py -text
scripts/neural_incremental_benchmark.cpp -text
tests/neural_qat_tests.py text eol=lf
tests/neural_qat_integration.py text eol=lf

# Keep pre-existing LF bytes used by the QAT measurement manifest on checkout.
include/regicide/board.hpp text eol=lf
include/regicide/see.hpp text eol=lf
include/regicide/transposition.hpp text eol=lf
include/regicide/uci.hpp text eol=lf
requirements-test.txt text eol=lf
src/board.cpp text eol=lf
src/evaluation.cpp text eol=lf
src/see.cpp text eol=lf
src/transposition.cpp text eol=lf
tests/engine_integration.py text eol=lf

# Preserve the precision experiment's datasets, model and frozen source bytes.
docs/checks/2026-10-19-neural-precision/** -text -whitespace
docs/NEURAL_PRECISION.md text eol=lf
scripts/neural_precision.py -text
scripts/neural_precision_experiment.py -text
tests/neural_precision_tests.py text eol=lf
tests/neural_precision_integration.py text eol=lf
tests/neural_precision_experiment_tests.py text eol=lf
tests/differential.py text eol=lf

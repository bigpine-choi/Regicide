# Machine-generated experiment evidence is preserved but collapsed in code review.
docs/matches/** linguist-generated=true
docs/profiles/** linguist-generated=true
# Preserve gprof's original fixed-width headers, including their trailing spaces.
docs/profiles/** whitespace=-blank-at-eol
# PGN uses blank lines between games and after the final game.
*.pgn whitespace=-blank-at-eof
